# Copia este archivo como .env y completa únicamente las variables necesarias.
# Nunca confirmes secretos en Git.

ANTHROPIC_API_KEY=
CLAUDE_BIN=claude
HIDROALERTA_DATA_DIR=./assets
HIDROALERTA_OUTPUT_DIR=./boletines
HIDROALERTA_LOG_PATH=./log_agentes.jsonl
LOG_LEVEL=INFO

# Reservadas para una fase posterior de despliegue.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# URL base de la API para el frontend. Vacío = mismo origen (producción,
# ver backend/main.py + run.sh). En desarrollo con `next dev`, apunta al
# uvicorn local, p. ej. http://localhost:8000.
NEXT_PUBLIC_API_URL=
