# Copia este archivo como .env y completa únicamente las variables necesarias.
# Nunca confirmes secretos en Git.

ANTHROPIC_API_KEY=
CLAUDE_BIN=claude

# Backend LLM: "auto" (Claude → Ollama fallback), "claude", u "ollama"
# Requiere: Claude CLI autenticado O Ollama instalado con un modelo descargado
LLM_BACKEND=auto
OLLAMA_MODEL=llama3.1
HIDROALERTA_DATA_DIR=./backend/data
HIDROALERTA_OUTPUT_DIR=./boletines
HIDROALERTA_LOG_PATH=./log_agentes.jsonl
LOG_LEVEL=INFO

# Reservadas para una fase posterior de despliegue.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# URL base de la API para el frontend. Vacío = mismo origen (producción,
# ver backend/main.py + run.sh). En desarrollo con `next dev`, apunta al
# uvicorn local, p. ej. http://localhost:8000.
NEXT_PUBLIC_API_URL=

# Supabase (base de datos)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=
